{
  "name": "intern-management-server",
  "version": "1.0.0",
  "description": "Express backend server for local PostgreSQL 18 migration",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "drop": "node scripts/dropTables.js",
