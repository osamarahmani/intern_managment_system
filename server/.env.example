# Production example: CORS_ORIGINS=https://ims.osamarahmani.tech
CORS_ORIGINS=
# Use SameSite=None for separate deployed frontend/backend domains. Use Lax for local-only deployments.
COOKIE_SAMESITE=Lax
SENDGRID_API_KEY=sendgrid-api-KEY
SENDGRID_FROM_EMAIL=from_mail
GROQ_API_KEY=your_groq_api_key_here
